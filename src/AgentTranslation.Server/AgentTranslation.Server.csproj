<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rwat</AssemblyName>
    <RootNamespace>AgentTranslation.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <!-- OpenCC 1.4.2 dictionaries (Apache-2.0), see Data/opencc/NOTICE.md -->
    <EmbeddedResource Include="Data\opencc\*.txt" LogicalName="opencc/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentTranslation.Core\AgentTranslation.Core.csproj" />
    <!-- Shared with the bridge mod so both sides use the same request format. No game dependency. -->
    <Compile Include="..\AgentTranslation.Bridge\InboxRequest.cs" Link="Bridge\InboxRequest.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="[2.3.1]" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.0]" />
  </ItemGroup>
</Project>
